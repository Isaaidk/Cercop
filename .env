# Peticiones por ciclo, para todas las fuentes. OCDS gasta una por término y año leído —la primera
# página más las últimas—: con 20 términos son unas 60, así que 60 se quedaba corto y el último
# término del lote nunca llegaba a completarse.
PRESUPUESTO_PETICIONES_CICLO=90

INTERVALO_VIGILANCIA_SEG=150

# --- Conexiones a la base -----------------------------------------------------
# El agrupador de Supabase (puerto 5432) funciona en **modo sesión** y admite **quince clientes**:
# lo dice él mismo al rechazar una conexión —«max clients are limited to pool_size: 15»—. Aquí la
# base está al otro lado de la red, así que ese número manda sobre cualquier otro: `max_connections`
# del servidor son sesenta, pero por el agrupador solo pasan quince.
#
# Con los valores por defecto (10 + 10) **un solo proceso** ya cabe justo en el tope y dos lo pasan.
# Cuando se pasa, el agotamiento no lo sufre quien lo pide: lo sufre todo el mundo, porque quien
# llega último no encuentra ninguna conexión y el API responde 500 a todo. Pasó el 2026-10-06, con
# tres workers acumulados de tres arranques (ver `levantar.ps1`).
#
# Con 4 + 2 por proceso: (4 + 2) × 2 procesos = 12 ≤ 15, y quedan tres ranuras para `psql`, el
# panel de Supabase o un guion de diagnóstico. Al desplegar contra el PostgreSQL propio
# (`deploy/`) el tope es otro y estos valores se ajustan allí, no aquí.
BD_POOL_SIZE=4
BD_MAX_OVERFLOW=2

